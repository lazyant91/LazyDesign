<Window
    x:Class="LazyDesign.Evaluation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LazyDesign.Evaluation"
    Title="Devices">
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
            <AppBarButton Label="Refresh" Click="Refresh_Click">
                <AppBarButton.Icon><SymbolIcon Symbol="Refresh"/></AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Key="F5"/></AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton Label="Add device" Click="AddDevice_Click">
                <AppBarButton.Icon><SymbolIcon Symbol="Add"/></AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Key="N" Modifiers="Control"/></AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Name="RemoveButton" Label="Remove" Click="Remove_Click" IsEnabled="False">
                <AppBarButton.Icon><SymbolIcon Symbol="Remove"/></AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Key="Delete"/></AppBarButton.KeyboardAccelerators>
            </AppBarButton>
        </CommandBar>
        <Grid x:Name="ContentGrid" Grid.Row="1" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Padding="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
                <TextBlock Text="Device" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Connection" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Status" FontWeight="SemiBold"/>
            </Grid>
            <ListView x:Name="DeviceList" Grid.Row="1" ItemsSource="{x:Bind Devices, Mode=OneWay}" SelectionMode="Single" SelectionChanged="DeviceList_SelectionChanged">
                <ListView.ItemTemplate><DataTemplate x:DataType="local:DeviceItem">
                    <Grid Padding="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind ConnectionType}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </DataTemplate></ListView.ItemTemplate>
            </ListView>
        </Grid>
        <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" Visibility="Collapsed">
            <TextBlock Text="No devices" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/>
            <TextBlock Text="Add a device to get started." Opacity="0.7" TextAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>