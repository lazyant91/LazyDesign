<Window
    x:Class="LazyDesign.Evaluation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="연결 설정">
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Padding="24">
            <StackPanel MaxWidth="420" HorizontalAlignment="Stretch" Spacing="24">
                <StackPanel Spacing="4">
                    <TextBlock Text="연결 설정" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="장치 연결에 사용할 프로필을 설정합니다." Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="연결 프로필 이름" FontWeight="SemiBold" />
                    <TextBox x:Name="ConnectionNameTextBox"
                             PlaceholderText="예: 작업실 장치"
                             TextChanged="ConnectionNameTextBox_TextChanged" />
                    <TextBlock Text="장치를 구분할 수 있는 이름을 입력하세요."
                               FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                    <TextBlock x:Name="NameValidationText"
                               Text="연결 프로필 이름을 입력하세요."
                               FontSize="12" Foreground="Red" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="전송 방식" FontWeight="SemiBold" />
                    <ComboBox x:Name="TransportComboBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="USB" />
                        <ComboBoxItem Content="Wi-Fi" />
                        <ComboBoxItem Content="Bluetooth" />
                    </ComboBox>
                </StackPanel>

                <ToggleSwitch x:Name="AutoReconnectToggle"
                              Header="자동 다시 연결"
                              OnContent="켬" OffContent="끔"
                              AutomationProperties.Name="사용 가능한 장치에 자동으로 다시 연결"
                              AutomationProperties.HelpText="사용 가능한 장치에 자동으로 다시 연결" />

                <TextBlock Text="사용 가능한 장치에 자동으로 다시 연결" TextWrapping="Wrap" Margin="0,-16,0,0" />

                <Button Content="연결 설정 저장"
                        HorizontalAlignment="Stretch"
                        Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>