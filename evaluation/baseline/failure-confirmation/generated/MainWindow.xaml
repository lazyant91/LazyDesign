<Window
    x:Class="LazyDesign.Evaluation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Device connection">
    <Grid x:Name="RootGrid" Padding="32" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="6">
            <TextBlock Text="장치 연결" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="저장된 장치의 연결 상태를 확인하고 관리합니다." Opacity="0.7" />
        </StackPanel>
        <InfoBar x:Name="ConnectionFailureInfoBar" Grid.Row="1" IsOpen="True" IsClosable="True"
                 Severity="Error" Title="연결 실패"
                 Message="장치가 응답하지 않았습니다. 장치가 켜져 있고 동일한 네트워크에 연결되어 있는지 확인한 후 다시 시도하세요.">
            <InfoBar.ActionButton>
                <Button x:Name="RetryButton" Content="Retry" Click="RetryButton_Click"
                        AutomationProperties.Name="장치 연결 다시 시도" />
            </InfoBar.ActionButton>
        </InfoBar>
        <StackPanel Grid.Row="2" Spacing="12">
            <TextBlock Text="저장된 장치" FontSize="20" FontWeight="SemiBold" />
            <Border Padding="16" BorderThickness="1" CornerRadius="8">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="거실 스피커" FontWeight="SemiBold" />
                        <TextBlock Text="연결할 수 없음" Opacity="0.7" />
                    </StackPanel>
                    <Button x:Name="RemoveDeviceButton" Grid.Column="1" Content="Remove"
                            Click="RemoveDeviceButton_Click" AutomationProperties.Name="거실 스피커 저장된 장치에서 제거" />
                </Grid>
            </Border>
        </StackPanel>
        <ContentDialog x:Name="RemoveDeviceDialog" Title="Remove saved device?" PrimaryButtonText="Remove"
                       CloseButtonText="Cancel" DefaultButton="Close" Closed="RemoveDeviceDialog_Closed"
                       AutomationProperties.Name="거실 스피커 제거 확인">
            <TextBlock Text="Remove '거실 스피커' from your saved devices? You can add it again later." TextWrapping="Wrap" />
        </ContentDialog>
    </Grid>
</Window>
