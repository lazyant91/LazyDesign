<Window
    x:Class="LazyDesign.Evaluation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Connection Settings">
    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <Grid
            MaxWidth="420"
            Padding="24"
            HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock
                    Text="장치 연결 설정"
                    Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="장치 연결에 사용할 프로필과 전송 방식을 설정합니다."
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,24,0,0" Spacing="6">
                <TextBox
                    x:Name="ConnectionNameTextBox"
                    Header="연결 프로필 이름"
                    HorizontalAlignment="Stretch"
                    TextChanged="ConnectionNameTextBox_TextChanged" />
                <TextBlock
                    Text="장치를 구분할 수 있는 이름을 입력하세요."
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <InfoBar
                    x:Name="NameValidationInfoBar"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Error"
                    Title="이름이 필요합니다"
                    Message="연결 프로필 이름을 입력하세요." />
            </StackPanel>

            <ComboBox
                Grid.Row="2"
                Margin="0,20,0,0"
                Header="전송 방식"
                HorizontalAlignment="Stretch"
                SelectedIndex="0">
                <ComboBoxItem Content="USB" />
                <ComboBoxItem Content="Wi-Fi" />
                <ComboBoxItem Content="Bluetooth" />
            </ComboBox>

            <StackPanel Grid.Row="3" Margin="0,20,0,0" Spacing="6">
                <TextBlock Text="자동 다시 연결" />
                <ToggleSwitch
                    x:Name="AutomaticReconnectToggle"
                    HorizontalAlignment="Left"
                    OffContent="사용 가능한 장치에 자동으로 다시 연결"
                    OnContent="사용 가능한 장치에 자동으로 다시 연결" />
            </StackPanel>

            <Button
                Grid.Row="4"
                Margin="0,24,0,0"
                HorizontalAlignment="Right"
                Content="연결 설정 저장"
                Click="SaveSettingsButton_Click" />
        </Grid>
    </ScrollViewer>
</Window>
