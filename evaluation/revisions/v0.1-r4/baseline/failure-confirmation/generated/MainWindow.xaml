<Window
    x:Class="LazyDesign.Evaluation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LazyDesign Evaluation">
    <Grid Padding="24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock
                Text="장치 관리"
                Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock
                Text="저장된 장치의 연결 상태를 확인하고 관리합니다."
                TextWrapping="Wrap" />
        </StackPanel>

        <InfoBar
            x:Name="ConnectionErrorInfoBar"
            Grid.Row="1"
            Title="장치 연결 실패"
            Message="장치가 응답하지 않았습니다. 장치가 켜져 있고 동일한 네트워크에 연결되어 있는지 확인한 후 다시 시도하세요."
            Severity="Error"
            IsOpen="True"
            IsClosable="True"
            AutomationProperties.Name="장치 연결 실패 알림">
            <InfoBar.ActionButton>
                <Button
                    x:Name="RetryButton"
                    Content="다시 시도"
                    Click="RetryButton_Click"
                    AutomationProperties.Name="장치 연결 다시 시도" />
            </InfoBar.ActionButton>
        </InfoBar>

        <StackPanel
            Grid.Row="2"
            Spacing="12">
            <TextBlock
                Text="저장된 장치"
                Style="{ThemeResource SubtitleTextBlockStyle}" />
            <StackPanel Spacing="2">
                <TextBlock
                    Text="거실 스피커"
                    FontWeight="SemiBold" />
                <TextBlock Text="마지막 연결에 실패했습니다." />
            </StackPanel>
            <Button
                x:Name="RemoveDeviceButton"
                Content="장치 제거"
                HorizontalAlignment="Left"
                Click="RemoveDeviceButton_Click"
                AutomationProperties.Name="거실 스피커 제거" />
        </StackPanel>

        <ContentDialog
            x:Name="RemoveDeviceDialog"
            Title="저장된 장치를 제거하시겠습니까?"
            PrimaryButtonText="제거"
            CloseButtonText="취소"
            DefaultButton="Close"
            AutomationProperties.Name="거실 스피커 제거 확인">
            <TextBlock
                Text="‘거실 스피커’를 저장된 장치에서 제거합니다. 이 작업은 되돌릴 수 없습니다."
                TextWrapping="Wrap" />
        </ContentDialog>
    </Grid>
</Window>
