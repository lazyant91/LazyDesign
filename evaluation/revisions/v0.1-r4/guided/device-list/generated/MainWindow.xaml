<Window
    x:Class="LazyDesign.Evaluation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LazyDesign.Evaluation"
    Title="Device list">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Devices"
                       Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="View connection type and current status, then select a device to remove it."
                       TextWrapping="Wrap" />
        </StackPanel>

        <CommandBar Grid.Row="1"
                    DefaultLabelPosition="Right"
                    IsDynamicOverflowEnabled="True">
            <AppBarButton Icon="Refresh"
                          Label="Refresh"
                          AutomationProperties.Name="Refresh"
                          Click="RefreshButton_Click" />
            <AppBarButton Icon="Add"
                          Label="Add device"
                          AutomationProperties.Name="Add device"
                          Click="AddDeviceButton_Click" />
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Name="RemoveDeviceButton"
                              Icon="Delete"
                              Label="Remove"
                              AutomationProperties.Name="Remove selected device"
                              Click="RemoveDeviceButton_Click" />
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <Grid Grid.Row="2">
            <ListView x:Name="DeviceList"
                      ItemsSource="{x:Bind Devices}"
                      SelectionMode="Single"
                      SelectionChanged="DeviceList_SelectionChanged"
                      AutomationProperties.Name="Devices"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:DeviceViewModel">
                        <StackPanel Padding="12,10"
                                    Spacing="4"
                                    AutomationProperties.Name="{x:Bind Name}">
                            <TextBlock Text="{x:Bind Name}"
                                       FontWeight="SemiBold"
                                       TextWrapping="WrapWholeWords" />
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Connection:" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ConnectionType}"
                                           TextWrapping="Wrap" />
                            </Grid>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Status:" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind Status}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel x:Name="EmptyState"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6">
                <SymbolIcon Symbol="World" />
                <TextBlock Text="No devices"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold" />
                <TextBlock Text="Add a device to see its connection type and status."
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="360" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
