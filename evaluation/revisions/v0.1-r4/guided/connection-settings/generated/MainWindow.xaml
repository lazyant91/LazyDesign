<Window
    x:Class="LazyDesign.Evaluation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LazyDesign Evaluation">
    <ScrollViewer HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollMode="Auto"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalContentAlignment="Stretch">
        <Grid Padding="24">
            <StackPanel Spacing="20"
                        HorizontalAlignment="Stretch">
                <TextBlock Text="연결 설정"
                           Style="{StaticResource TitleTextBlockStyle}"
                           TextWrapping="Wrap" />

                <StackPanel Spacing="4">
                    <TextBox x:Name="ConnectionNameTextBox"
                             Header="연결 프로필 이름"
                             AutomationProperties.Name="연결 프로필 이름"
                             TextChanged="ConnectionNameTextBox_TextChanged" />
                    <TextBlock Text="장치를 구분할 수 있는 이름을 입력하세요."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="ConnectionNameValidationText"
                               Text="연결 프로필 이름을 입력하세요."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"
                               Visibility="Visible"
                               AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>

                <ComboBox x:Name="TransportComboBox"
                          Header="전송 방식"
                          AutomationProperties.Name="전송 방식"
                          SelectedIndex="0"
                          HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="USB" />
                    <ComboBoxItem Content="Wi-Fi" />
                    <ComboBoxItem Content="Bluetooth" />
                </ComboBox>

                <ToggleSwitch x:Name="AutomaticReconnectToggle"
                              AutomationProperties.Name="사용 가능한 장치에 자동으로 다시 연결">
                    <ToggleSwitch.Header>
                        <TextBlock Text="사용 가능한 장치에 자동으로 다시 연결"
                                   TextWrapping="Wrap" />
                    </ToggleSwitch.Header>
                </ToggleSwitch>

                <Button x:Name="SaveSettingsButton"
                        Content="연결 설정 저장"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Left"
                        Click="SaveSettingsButton_Click" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
