<Window
    x:Class="LazyDesign.Evaluation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LazyDesign Evaluation">
    <Grid Padding="24">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled">
            <StackPanel Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock Text="저장된 장치"
                               Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="연결 상태를 확인하거나 저장된 장치를 제거할 수 있습니다."
                               TextWrapping="Wrap" />
                </StackPanel>

                <InfoBar x:Name="ConnectionErrorInfoBar"
                         Title="장치 연결 실패"
                         Message="장치가 응답하지 않았습니다. 장치가 켜져 있고 동일한 네트워크에 연결되어 있는지 확인한 후 다시 시도하세요."
                         Severity="Error"
                         IsOpen="True"
                         IsClosable="True">
                    <InfoBar.ActionButton>
                        <Button Content="Retry"
                                AutomationProperties.Name="장치 연결 다시 시도"
                                Click="RetryConnection_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="회의실 디스플레이"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="저장됨" />
                    </StackPanel>

                    <Button Content="Remove saved device"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="회의실 디스플레이 저장된 장치 제거"
                            Click="RemoveDeviceButton_Click" />
                </StackPanel>

                <ContentDialog x:Name="RemoveDeviceDialog"
                               Title="저장된 장치를 제거하시겠습니까?"
                               PrimaryButtonText="Remove"
                               CloseButtonText="Cancel"
                               DefaultButton="Close">
                    <TextBlock Text="선택한 장치 '회의실 디스플레이'를 저장된 장치 목록에서 제거합니다."
                               TextWrapping="Wrap" />
                </ContentDialog>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
