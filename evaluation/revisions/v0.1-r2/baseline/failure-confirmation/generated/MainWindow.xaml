<Window
    x:Class="LazyDesign.Evaluation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LazyDesign Evaluation">
    <Grid
        x:Name="RootGrid"
        Padding="32"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel
            Width="640"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Spacing="20">
            <StackPanel Spacing="8">
                <TextBlock
                    Text="장치 연결"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="연결 상태를 확인하거나 저장된 장치를 관리합니다."
                    TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar
                x:Name="ConnectionFailureInfoBar"
                Title="연결 실패"
                Message="장치가 응답하지 않았습니다. 장치가 켜져 있고 동일한 네트워크에 연결되어 있는지 확인한 후 다시 시도하세요."
                Severity="Error"
                IsOpen="True"
                IsClosable="True">
                <InfoBar.ActionButton>
                    <Button
                        x:Name="RetryButton"
                        Content="Retry"
                        Click="RetryButton_Click"
                        AutomationProperties.Name="장치 연결 다시 시도" />
                </InfoBar.ActionButton>
            </InfoBar>

            <StackPanel Spacing="12">
                <TextBlock
                    Text="선택한 장치"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    x:Name="SelectedDeviceNameText"
                    Text="거실 TV"
                    FontSize="20"
                    FontWeight="SemiBold"
                    AutomationProperties.Name="선택한 장치 거실 TV" />
                <TextBlock
                    Text="이 장치는 저장된 장치 목록에 있습니다."
                    TextWrapping="Wrap" />
                <Button
                    x:Name="RemoveDeviceButton"
                    HorizontalAlignment="Left"
                    Content="저장된 장치 제거..."
                    Click="RemoveDeviceButton_Click"
                    AutomationProperties.Name="거실 TV 저장된 장치에서 제거" />
                <TextBlock
                    x:Name="RemovalStatusText"
                    Visibility="Collapsed"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <ContentDialog
            x:Name="RemoveDeviceDialog"
            Title="거실 TV 제거"
            PrimaryButtonText="Remove"
            CloseButtonText="Cancel"
            DefaultButton="Close"
            AutomationProperties.Name="거실 TV 제거 확인">
            <TextBlock
                Text="선택한 장치 '거실 TV'를 저장된 장치 목록에서 제거하시겠습니까? 이 작업은 되돌릴 수 없습니다."
                TextWrapping="Wrap" />
        </ContentDialog>
    </Grid>
</Window>
