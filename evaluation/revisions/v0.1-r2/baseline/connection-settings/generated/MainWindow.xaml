<Window
    x:Class="LazyDesign.Evaluation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="연결 설정">
    <Grid Padding="24">
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel
                MaxWidth="420"
                HorizontalAlignment="Stretch"
                Spacing="20">
                <StackPanel Spacing="6">
                    <TextBlock
                        Style="{ThemeResource TitleTextBlockStyle}"
                        Text="연결 설정" />
                    <TextBlock
                        Text="장치 연결에 사용할 프로필과 전송 방식을 구성합니다."
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBox
                        x:Name="ConnectionNameTextBox"
                        Header="연결 프로필 이름"
                        TextChanged="ConnectionNameTextBox_TextChanged" />
                    <TextBlock
                        Text="장치를 구분할 수 있는 이름을 입력하세요."
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="NameValidationMessage"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="연결 프로필 이름을 입력하세요."
                        TextWrapping="Wrap" />
                </StackPanel>

                <ComboBox
                    x:Name="TransportComboBox"
                    Header="전송 방식"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="0">
                    <ComboBoxItem Content="USB" />
                    <ComboBoxItem Content="Wi-Fi" />
                    <ComboBoxItem Content="Bluetooth" />
                </ComboBox>

                <ToggleSwitch x:Name="AutomaticReconnectToggle">
                    <ToggleSwitch.Header>
                        <TextBlock
                            Text="사용 가능한 장치에 자동으로 다시 연결"
                            TextWrapping="Wrap" />
                    </ToggleSwitch.Header>
                </ToggleSwitch>

                <Button
                    x:Name="SaveButton"
                    HorizontalAlignment="Stretch"
                    Click="SaveButton_Click"
                    Content="연결 설정 저장" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
