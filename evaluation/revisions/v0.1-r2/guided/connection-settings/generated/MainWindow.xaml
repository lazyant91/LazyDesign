<Window
    x:Class="LazyDesign.Evaluation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="연결 설정">
    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <Grid Padding="24">
            <StackPanel Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock
                        Text="연결 설정"
                        Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        Text="장치 연결 프로필을 구성합니다."
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBox
                        x:Name="ConnectionNameTextBox"
                        Header="연결 프로필 이름"
                        MaxLength="80"
                        TextChanged="ConnectionNameTextBox_TextChanged" />
                    <TextBlock
                        Text="장치를 구분할 수 있는 이름을 입력하세요."
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        x:Name="NameValidationText"
                        Text="연결 프로필 이름을 입력하세요."
                        TextWrapping="Wrap"
                        Visibility="Collapsed"
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>

                <ComboBox
                    x:Name="TransportComboBox"
                    Header="전송 방식"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="0">
                    <ComboBoxItem Content="USB" />
                    <ComboBoxItem Content="Wi-Fi" />
                    <ComboBoxItem Content="Bluetooth" />
                </ComboBox>

                <ToggleSwitch
                    x:Name="AutomaticReconnectToggle"
                    Header="사용 가능한 장치에 자동으로 다시 연결"
                    OffContent="꺼짐"
                    OnContent="켜짐" />

                <Button
                    Content="연결 설정 저장"
                    HorizontalAlignment="Left"
                    Click="SaveButton_Click"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
