<Window
    x:Class="LazyDesign.Evaluation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LazyDesign Evaluation">
    <Grid x:Name="RootGrid" Padding="24">
        <StackPanel Spacing="20">
            <StackPanel Spacing="4">
                <TextBlock Text="장치 연결"
                           Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="저장된 장치의 연결 상태를 확인하거나 장치를 제거할 수 있습니다."
                           TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar x:Name="ConnectionErrorInfoBar"
                     Title="거실 디스플레이에 연결할 수 없습니다."
                     Message="장치가 응답하지 않았습니다. 장치가 켜져 있고 동일한 네트워크에 연결되어 있는지 확인한 후 다시 시도하세요."
                     Severity="Error"
                     IsOpen="True"
                     IsClosable="True"
                     AutomationProperties.Name="장치 연결 실패">
                <InfoBar.ActionButton>
                    <Button x:Name="RetryButton"
                            Content="Retry"
                            AutomationProperties.Name="장치 연결 다시 시도"
                            Click="RetryConnection_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <StackPanel Spacing="8">
                <TextBlock Text="선택된 저장 장치"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="거실 디스플레이"
                           AutomationProperties.Name="선택된 장치: 거실 디스플레이" />
                <Button x:Name="RemoveDeviceButton"
                        Content="Remove saved device"
                        AutomationProperties.Name="저장된 장치 거실 디스플레이 제거"
                        Click="RemoveDeviceButton_Click" />
            </StackPanel>
        </StackPanel>

        <ContentDialog x:Name="RemoveDeviceDialog"
                       Title="저장된 장치를 제거할까요?"
                       PrimaryButtonText="Remove"
                       CloseButtonText="Cancel"
                       DefaultButton="Close">
            <TextBlock Text="저장된 장치 '거실 디스플레이'가 이 PC에서 제거됩니다. 다시 사용하려면 장치를 다시 추가해야 합니다."
                       TextWrapping="Wrap" />
        </ContentDialog>
    </Grid>
</Window>
