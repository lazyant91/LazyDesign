<Window
    x:Class="LazyDesign.Evaluation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="연결 설정">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="640" Padding="24" HorizontalAlignment="Center">
            <StackPanel Spacing="24">
                <StackPanel Spacing="4">
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="연결 설정" TextWrapping="Wrap" />
                    <TextBlock Opacity="0.72" Text="장치에 연결할 방법과 다시 연결 동작을 설정합니다." TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="연결 프로필 이름" />
                    <TextBox x:Name="ConnectionNameTextBox" HorizontalAlignment="Stretch" TextChanged="ConnectionNameTextBox_TextChanged" />
                    <TextBlock Opacity="0.72" Text="장치를 구분할 수 있는 이름을 입력하세요." TextWrapping="Wrap" />
                    <TextBlock x:Name="NameValidationMessage" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="연결 프로필 이름을 입력하세요." TextWrapping="Wrap" Visibility="Visible" />
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="전송 방식" />
                    <ComboBox HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem Content="USB" />
                        <ComboBoxItem Content="Wi-Fi" />
                        <ComboBoxItem Content="Bluetooth" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="자동 다시 연결" />
                    <ToggleSwitch Header="사용 가능한 장치에 자동으로 다시 연결" />
                </StackPanel>
                <Button HorizontalAlignment="Left" Click="SaveButton_Click" Content="연결 설정 저장" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>