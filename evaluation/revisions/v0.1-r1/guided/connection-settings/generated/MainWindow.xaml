<Window
    x:Class="LazyDesign.Evaluation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="장치 연결 설정">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid Padding="24">
            <StackPanel MaxWidth="420"
                        Spacing="16">
                <TextBlock Text="장치 연결 설정"
                           Style="{StaticResource TitleTextBlockStyle}" />
                <StackPanel Spacing="4">
                    <TextBox x:Name="ConnectionNameTextBox"
                             Header="연결 프로필 이름"
                             AutomationProperties.HelpText="장치를 구분할 수 있는 이름을 입력하세요."
                             LostFocus="ConnectionNameTextBox_LostFocus"
                             TextChanged="ConnectionNameTextBox_TextChanged" />
                    <TextBlock Text="장치를 구분할 수 있는 이름을 입력하세요."
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock x:Name="ConnectionNameError"
                               Text="연결 프로필 이름을 입력하세요."
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               AutomationProperties.LiveSetting="Polite"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
                <ComboBox x:Name="TransportComboBox"
                          Header="전송 방식"
                          SelectedIndex="0">
                    <ComboBoxItem Content="USB" />
                    <ComboBoxItem Content="Wi-Fi" />
                    <ComboBoxItem Content="Bluetooth" />
                </ComboBox>
                <ToggleSwitch x:Name="AutoReconnectToggle"
                              Header="사용 가능한 장치에 자동으로 다시 연결"
                              OffContent="끔"
                              OnContent="켬"
                              Toggled="AutoReconnectToggle_Toggled" />
                <Button Content="연결 설정 저장"
                        HorizontalAlignment="Left"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
