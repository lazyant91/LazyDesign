<Window
    x:Class="LazyDesign.Evaluation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="장치 연결 설정">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled">
        <Grid Padding="24">
            <StackPanel Spacing="20" HorizontalAlignment="Stretch">
                <StackPanel Spacing="4">
                    <TextBox x:Name="ConnectionNameTextBox"
                             Header="연결 프로필 이름"
                             MaxLength="80"
                             TextChanged="ConnectionNameTextBox_TextChanged"
                             AutomationProperties.HelpText="장치를 구분할 수 있는 이름을 입력하세요." />
                    <TextBlock Text="장치를 구분할 수 있는 이름을 입력하세요."
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock x:Name="NameValidationTextBlock"
                               Text="연결 프로필 이름을 입력하세요."
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>

                <ComboBox Header="전송 방식"
                          SelectedIndex="0"
                          HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="USB" />
                    <ComboBoxItem Content="Wi-Fi" />
                    <ComboBoxItem Content="Bluetooth" />
                </ComboBox>

                <ToggleSwitch Header="사용 가능한 장치에 자동으로 다시 연결" />

                <StackPanel Spacing="8" HorizontalAlignment="Left">
                    <Button Content="연결 설정 저장"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="SaveButton_Click" />
                    <TextBlock x:Name="SaveStatusTextBlock"
                               Text="연결 설정이 저장되었습니다."
                               Visibility="Collapsed"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>