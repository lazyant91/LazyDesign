{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lazyant91/LazyDesign/evaluation/gate-metrics.schema.json",
  "title": "LazyDesign v0.1 gate metrics",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenarios", "traceable_improvements"],
  "properties": {
    "schema_version": {"const": 1},
    "scenarios": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connection-settings", "device-list", "failure-confirmation"],
      "properties": {
        "connection-settings": {"$ref": "#/$defs/scenario"},
        "device-list": {"$ref": "#/$defs/scenario"},
        "failure-confirmation": {"$ref": "#/$defs/scenario"}
      }
    },
    "traceable_improvements": {
      "type": "array",
      "items": {"$ref": "#/$defs/trace"}
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "guided"],
      "properties": {
        "baseline": {"$ref": "#/$defs/result"},
        "guided": {"$ref": "#/$defs/result"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scores", "score_evidence", "defects"],
      "properties": {
        "scores": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {"type": "integer", "minimum": 0, "maximum": 2}
        },
        "score_evidence": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {"$ref": "#/$defs/scoreEvidence"}
        },
        "defects": {"$ref": "#/$defs/defects"}
      }
    },
    "scoreEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "score", "evidence", "uncertainty"],
      "properties": {
        "category": {"type": "integer", "minimum": 1, "maximum": 10},
        "score": {"type": "integer", "minimum": 0, "maximum": 2},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "uncertainty": {"type": "string", "minLength": 1}
      }
    },
    "defects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overflow",
        "anatomy",
        "accessibility",
        "control_template",
        "complexity",
        "build_failures",
        "render_failures"
      ],
      "properties": {
        "overflow": {"type": "integer", "minimum": 0},
        "anatomy": {"type": "integer", "minimum": 0},
        "accessibility": {"type": "integer", "minimum": 0},
        "control_template": {"type": "integer", "minimum": 0},
        "complexity": {"type": "integer", "minimum": 0},
        "build_failures": {"type": "integer", "minimum": 0},
        "render_failures": {"type": "integer", "minimum": 0}
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario", "category", "rule_ids", "evidence"],
      "properties": {
        "scenario": {
          "enum": ["connection-settings", "device-list", "failure-confirmation"]
        },
        "category": {"type": "integer", "minimum": 1, "maximum": 10},
        "rule_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
